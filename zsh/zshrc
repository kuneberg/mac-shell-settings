# ~/.dotfiles/zsh/zshrc
# Sourced by the managed block in ~/.zshrc (interactive shells).

# Homebrew prefix — zprofile normally exports HOMEBREW_PREFIX; fall back
# for shells that skipped the login step (e.g. some IDE terminals).
if [[ -z "${HOMEBREW_PREFIX:-}" ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

# --- Shell options ---
setopt AUTO_CD              # `some/dir` behaves like `cd some/dir`
setopt INTERACTIVE_COMMENTS # allow # comments on the command line
setopt HIST_IGNORE_ALL_DUPS # drop older duplicates from history
setopt HIST_IGNORE_SPACE    # commands starting with a space stay out of history
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY

# --- Environment, aliases, functions ---
source "$HOME/.dotfiles/zsh/exports.zsh"
source "$HOME/.dotfiles/zsh/aliases.zsh"
source "$HOME/.dotfiles/zsh/functions.zsh"

# --- Terminal title (window / tab header) ---
# Directory name at the prompt, "dir | binary" while a command runs
# (e.g. `Work | claude`). Applies to every terminal: Ghostty's own title
# feature is off in ghostty/config so this format is used there as well.
# OSC 0 (not 2): iTerm2 shows the *icon* title in tabs, OSC 2 only renames
# the window; Ghostty and Alacritty treat 0 and 2 the same.
autoload -Uz add-zsh-hook
_dotfiles_title_precmd() { print -rn -- $'\e]0;'"${(%):-%1~}"$'\a' }
_dotfiles_title_preexec() {
  # $2 is the alias-expanded command line. Keep its first real word,
  # skipping env assignments, wrappers (sudo, command, time, ...) and
  # their options; show only the basename of the binary.
  local -a words; words=(${(z)2})
  while (( $#words )) && [[ "$words[1]" == (*=*|-*|sudo|command|builtin|exec|noglob|nocorrect|time|nohup) ]]; do
    shift words
  done
  local bin="${words[1]:t}"
  print -rn -- $'\e]0;'"${(%):-%1~}${bin:+ | $bin}"$'\a'
}
add-zsh-hook precmd  _dotfiles_title_precmd
add-zsh-hook preexec _dotfiles_title_preexec

# --- Completion ---
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # case-insensitive
zstyle ':completion:*' menu no                             # let fzf-tab drive the menu
zstyle ':completion:*:descriptions' format '[%d]'

# --- Plugins & tools ---
# Order matters: fzf -> fzf-tab -> autosuggestions ... syntax-highlighting last.
# Every plugin is optional so a fresh machine works before `brew bundle` ran.
_dotfiles_source_if_readable() { [[ -r "$1" ]] && source "$1"; return 0 }

if (( $+commands[fzf] )); then
  source <(fzf --zsh)
fi

if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  _dotfiles_source_if_readable "$HOMEBREW_PREFIX/share/fzf-tab/fzf-tab.zsh"
  _dotfiles_source_if_readable "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# fzf-tab inherits the gotham colors from FZF_DEFAULT_OPTS
zstyle ':fzf-tab:*' use-fzf-default-opts yes

# Autosuggestion ghost text in muted warm grey to match the palette
export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#245361"

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi
# atuin owns Ctrl-R (overriding fzf's binding above); up-arrow stays native.
if (( $+commands[atuin] )); then
  eval "$(atuin init zsh --disable-up-arrow)"

  # Directory-aware autosuggestions. Atuin records the cwd of every
  # command: prefer matches typed in THIS directory, then global history.
  # For `cd`/`z` suggestions, skip candidates whose target no longer
  # exists from here (deleted dirs, relative paths from elsewhere).
  _zsh_autosuggest_atuin_pick() {
    local mode="$1" prefix="$2" c target
    local -a candidates
    candidates=("${(@f)$(atuin search --cmd-only --limit 20 --search-mode prefix --filter-mode "$mode" -- "$prefix" 2>/dev/null)}")
    for c in "${candidates[@]}"; do
      [[ -n "$c" ]] || continue
      if [[ "$c" == (cd|z)\ * ]]; then
        target="${(Q)${c#* }}"
        [[ -d "${target/#\~/$HOME}" ]] || continue
      fi
      suggestion="$c"
      return 0
    done
    return 1
  }
  _zsh_autosuggest_strategy_atuin_cwd()    { _zsh_autosuggest_atuin_pick directory "$1" }
  _zsh_autosuggest_strategy_atuin_global() { _zsh_autosuggest_atuin_pick global "$1" }
  # Set AFTER atuin init, which injects its own non-cwd-aware strategy.
  ZSH_AUTOSUGGEST_STRATEGY=(atuin_cwd atuin_global)
fi
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi

# Syntax highlighting must be sourced last.
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  _dotfiles_source_if_readable "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

unfunction _dotfiles_source_if_readable

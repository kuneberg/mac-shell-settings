# lf file colors — matches `ls` (eza). Linked via ~/.config/lf/colors
#
# eza emits plain ANSI-16 codes, so every rule here uses ANSI codes too:
# both tools resolve through the terminal's srcery palette and always agree.
# Only the default text is hex (body #fce8c3 = the terminal foreground;
# srcery's ANSI 7 is a darker tan, so plain files must not use it). One pattern per line, no brace expansion. Match order:
# full path > dir name > file type > name > basename > extension > fi.
#
# eza classes: dir=bold blue, exec=bold green, link=cyan, broken=red,
# image=magenta, video=bold magenta, audio=cyan, archive=red, doc=green,
# source=bold yellow, README/Makefile=bold yellow (eza's underline dropped).

# --- file types ---
ln  36
or  31
tw  01;34
ow  01;34
st  01;34
di  01;34
pi  33
so  01;35
bd  01;33
cd  01;33
su  01;32
sg  01;32
ex  01;32
fi  38;2;252;232;195


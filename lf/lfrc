# lf — terminal file manager. Linked (whole lf/ directory) to ~/.config/lf
#
# Enter on a directory -> quit INTO it: the shell wrapper in zsh/functions.zsh
# sets $LF_CD_FILE, enter-or-open writes the directory there and quits, the
# wrapper cds. Without the wrapper (plain `command lf`) Enter just enters the
# directory inside lf. Enter on a file -> open it.
#
# Type-to-filter: every letter/digit key opens the filter prompt with that
# character, the list narrows as you type (incfilter), Enter accepts.
# Esc clears an active filter, or quits when none is active. Backspace
# clears the filter. Because letters are taken, commands live on ctrl/F keys
# (see --- keys ---) and navigation is arrows + Enter.

set shell sh
set shellopts '-eu'
set ifs "\n"

# --- behaviour (mirrors the previous yazi setup) ---
set hidden false   # `lf -a` (zsh wrapper) starts with hidden files shown; `.` toggles
set dirfirst true
set sortby natural
set info size
set dircounts true
set ratios 1:3:4
set scrolloff 8
set period 1
set incsearch true
set incfilter true
set ignorecase true
set smartcase true
set tabstop 2
set icons true
set drawbox true
set previewer ~/.config/lf/preview.sh

# --- gotham chrome (file colors live in ./colors) ---
# hovered row: cyan #33859e bg, ink #0c1014 text
set cursoractivefmt  "\033[38;2;12;16;20;48;2;51;133;158m"
# parent / preview hover: base4 #245361 bg, bright #d3ebe9 text
set cursorparentfmt  "\033[38;2;211;235;233;48;2;36;83;97m"
set cursorpreviewfmt "\033[38;2;211;235;233;48;2;36;83;97m"
# box borders: base4
set borderfmt "\033[38;2;36;83;97m"
# prompt line: path in base5 #599cab, file in body #99d1ce
set promptfmt "\033[38;2;89;156;171m%d\033[0m\033[1;38;2;153;209;206m%f\033[0m"
set errorfmt "\033[38;2;194;49;39m"

# --- commands ---
cmd enter-or-open &{{
    if [ -d "$f" ] && [ -n "${LF_CD_FILE:-}" ]; then
        printf '%s' "$f" > "$LF_CD_FILE"
        lf -remote "send $id quit"
    else
        lf -remote "send $id open"
    fi
}}

# Esc: clear the filter if one is active (fewer rows shown than exist),
# otherwise quit. lf exposes no filter state, so compare the displayed list
# with the directory contents (respecting the hidden option).
cmd esc-or-quit %{{
    shown=$(lf -remote "query $id files" | grep -c . || true)
    if [ "${lf_hidden:-false}" = "true" ]; then
        total=$(find . -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')
    else
        total=$(find . -mindepth 1 -maxdepth 1 -not -name '.*' | wc -l | tr -d ' ')
    fi
    if [ "$shown" -lt "$total" ]; then
        lf -remote "send $id setfilter"
    else
        lf -remote "send $id quit"
    fi
}}

cmd mkdir %mkdir -p -- "$@"
cmd touch %touch -- "$@"

# --- keys ---
map <enter>     enter-or-open
map <esc>       esc-or-quit
map <backspace> setfilter
map <backspace2> setfilter
map <c-c>       quit
map <c-d>       quit
map <c-q>       quit
map <f2>        push :rename<space>
map <f3>        $$PAGER "$f"
map <f4>        $$EDITOR "$f"
map <f7>        push :mkdir<space>
map <f8>        delete
map <c-t>       push :touch<space>
map <c-x>       cut
map <c-y>       copy
map <c-v>       paste
map <c-a>       set hidden!
map ~           cd ~


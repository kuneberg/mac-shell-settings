# Ghostty configuration — macOS
# Docs: https://ghostty.org/docs/config
# Linked to ~/.config/ghostty/config — reload with cmd+shift+, after edits.

# --- Font ---
font-family = JetBrainsMono Nerd Font
font-size = 15
font-thicken = true

# --- Theme (Gotham) ---
# Gotham ANSI-16 palette (terminalcolors.com/themes/gotham/default)
palette = 0=#0c1014
palette = 1=#c23127
palette = 2=#2aa889
palette = 3=#edb443
palette = 4=#195466
palette = 5=#4e5166
palette = 6=#33859e
palette = 7=#99d1ce
palette = 8=#0c1014
palette = 9=#c23127
palette = 10=#2aa889
palette = 11=#edb443
palette = 12=#195466
palette = 13=#4e5166
palette = 14=#33859e
palette = 15=#99d1ce
foreground = #99d1ce
# Gotham near-black background
background = #0c1014
background-opacity = 0.70
background-blur = 22
cursor-color = #99d1ce
cursor-text = #11151c
selection-background = #0a3749
selection-foreground = #99d1ce

# --- Window ---
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
macos-titlebar-style = native
window-save-state = always

# --- Cursor & mouse ---
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# --- Behaviour ---
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = false
macos-option-as-alt = true
shell-integration = zsh
# title is set by zsh (zsh/zshrc) as "dir | binary" — keep Ghostty's own off
shell-integration-features = cursor,sudo

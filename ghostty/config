# Ghostty configuration — macOS
# Docs: https://ghostty.org/docs/config
# Linked to ~/.config/ghostty/config — reload with cmd+shift+, after edits.

# --- Font ---
font-family = JetBrainsMono Nerd Font
font-size = 15
font-thicken = true

# --- Theme (Terra) ---
# Custom terra ANSI-16 palette (matches the starship palette)
palette = 0=#414a42
palette = 1=#d0686e
palette = 2=#859e89
palette = 3=#edc27a
palette = 4=#7e9ca8
palette = 5=#b48ea3
palette = 6=#84a89a
palette = 7=#d6c8bd
palette = 8=#5f695c
palette = 9=#dd8288
palette = 10=#9ab3a0
palette = 11=#f4d49a
palette = 12=#94b2bd
palette = 13=#c9a5b8
palette = 14=#9dc0b0
palette = 15=#a89a8f
foreground = #e8d7d0
# Green-black background
background = #161a16
background-opacity = 0.80
background-blur = 22
# Terra accents
cursor-color = #f77d5b
cursor-text = #161a16
selection-background = #3c4a3e
selection-foreground = #f5ede4

# --- Window ---
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
macos-titlebar-style = tabs
window-save-state = always

# --- Cursor & mouse ---
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# --- Behaviour ---
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = false
macos-option-as-alt = true
shell-integration = zsh
shell-integration-features = cursor,sudo,title

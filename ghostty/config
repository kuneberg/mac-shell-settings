# Ghostty configuration — macOS
# Docs: https://ghostty.org/docs/config
# Linked to ~/.config/ghostty/config — reload with cmd+shift+, after edits.

# --- Font ---
font-family = JetBrainsMono Nerd Font
font-size = 15
font-thicken = true

# --- Theme ---
theme = Catppuccin Mocha
# Cool dark background override
background = #14171c
background-opacity = 0.80
background-blur = 22
# Amethyst accents (match the starship palette)
cursor-color = #a78bfa
cursor-text = #14171c
selection-background = #372a5e
selection-foreground = #f2ebff

# --- Window ---
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
macos-titlebar-style = tabs
window-save-state = always

# --- Cursor & mouse ---
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# --- Behaviour ---
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = false
macos-option-as-alt = true
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Ghostty configuration — macOS
# Docs: https://ghostty.org/docs/config
# Linked to ~/.config/ghostty/config — reload with cmd+shift+, after edits.

# --- Font ---
font-family = JetBrainsMono Nerd Font
font-size = 15
font-thicken = true

# --- Theme ---
theme = Catppuccin Mocha
# Alternative that matches the Gruvbox starship prompt:
# theme = GruvboxDark
# Warm dark background override (Catppuccin's base #1e1e2e reads blueish)
background = #1c1714
background-opacity = 0.80
background-blur = true

# --- Window ---
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
macos-titlebar-style = tabs
window-save-state = always

# --- Cursor & mouse ---
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# --- Behaviour ---
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = false
macos-option-as-alt = true
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Ghostty configuration — macOS
# Docs: https://ghostty.org/docs/config
# Linked to ~/.config/ghostty/config — reload with cmd+shift+, after edits.

# --- Font ---
font-family = JetBrainsMono Nerd Font
font-size = 15
font-thicken = true
# Window and tab titles: zsh (zsh/zshrc) puts Nerd Font glyphs (folder,
# home, Claude) in the title, which are private-use code points the system
# font cannot render — so the title bar uses the same Nerd Font.
window-title-font-family = JetBrainsMono Nerd Font

# --- Theme (Srcery) ---
# Srcery ANSI-16 palette (terminalcolors.com/themes/srcery/default)
palette = 0=#1c1b19
palette = 1=#ef2f27
palette = 2=#519f50
palette = 3=#fbb829
palette = 4=#2c78bf
palette = 5=#e02c6d
palette = 6=#0aaeb3
palette = 7=#baa67f
palette = 8=#918175
palette = 9=#f75341
palette = 10=#98bc37
palette = 11=#fed06e
palette = 12=#68a8e4
palette = 13=#ff5c8f
palette = 14=#2be4d0
palette = 15=#fce8c3
foreground = #fce8c3
# Window background colour. Srcery's own black is #1c1b19; this is instead a
# warm brown between the glow image's top edge (#2b2117) and corners (#1a110a),
# because the transparent/tabs titlebar is a flat layer in this colour (the
# image never reaches it) and should read as a continuation of the gradient.
background = #241a12
background-opacity = 0.70
background-blur = 22
cursor-color = #fbb829
cursor-text = #1c1b19
selection-background = #fce8c3
selection-foreground = #1c1b19
# Amber CRT screen: opaque radial gradient from warm brown #392d21 in the
# centre to #1a110a in the corners (colours sampled from a photo of an orange
# phosphor monitor). Ghostty draws it over `background` and then applies
# background-opacity, so the 0.70 translucency still shows through; linked
# to ~/.config/ghostty/orange-glow.png by setup-links.sh.
background-image = ~/.config/ghostty/orange-glow.png
background-image-fit = cover
background-image-position = center

# --- Window ---
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
# tabs: custom titlebar with the tab bar embedded in the title row, always
# matching the terminal background. "transparent" is the native layout with
# the background showing through; "hidden" drops the title row entirely.
# Note: "tabs" showed layout glitches (tabs bunched at the left) on macOS 27
# with Ghostty 1.3.x; fixed upstream as of 1.4.0, so this is back on tabs.
# Changing this only applies to new windows: restart Ghostty (or open a new
# window) after reloading the config.
macos-titlebar-style = tabs
# macOS puts a proxy icon (the working directory's folder) next to the window
# title once the shell reports its cwd; the zsh title already carries its own
# folder/home glyph, so the native one is off to avoid two icons.
macos-titlebar-proxy-icon = hidden
# Dock/app icon: the "retro" variant of the Ghostty icon (needs app restart)
macos-icon = retro
window-save-state = always

# --- Cursor & mouse ---
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# --- Behaviour ---
# Bell (e.g. Claude Code rings it when a turn finishes): bounce the dock
# icon only. The default `title` feature prepends a 🔔 emoji to the window
# and tab title until the window is refocused — there is no way to pick a
# different glyph, so it is off to keep the Nerd Font title clean.
bell-features = no-system,no-audio,attention,no-title,no-border
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = false
macos-option-as-alt = true
shell-integration = zsh
# title is set by zsh (zsh/zshrc) as "<icon> dir | binary" — keep Ghostty's own off.
# Features not listed keep their defaults (title is on by default), so it must
# be disabled explicitly with no-title; otherwise Ghostty's zsh precmd/preexec
# hooks overwrite the title with the plain cwd / command on every prompt.
shell-integration-features = cursor,sudo,no-title
